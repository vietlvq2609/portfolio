---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Bio from '../components/Bio.astro';
import ExperienceTimeline from '../components/ExperienceTimeline.astro';
import TechStack from '../components/TechStack.astro';
import FeedSection from '../components/FeedSection.astro';
import Education from "../components/Education.astro";
---

<BaseLayout title="Viet Le — Full-Stack Software Engineer">
  <Header />
  <main class="mx-auto max-w-6xl space-y-10 px-6 py-10">
    <Bio />
    <TechStack />
    <ExperienceTimeline />

    <FeedSection />

    <Education />
  </main>
  <Footer />
</BaseLayout>


