---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Tag from '../components/Tag.astro';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  tags: string[];
}

const { title, description, pubDate, updatedDate, tags } = Astro.props;

const dateLabel = pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric'
});
---

<BaseLayout title={`${title} — Viet Le`} description={description}>
  <Header />
  <main class="mx-auto max-w-3xl px-6 py-12">
    <a href="/blog" class="font-mono text-xs text-zinc-500 hover:text-cyan-400">&larr; back to blog</a>

    <article class="prose-journal mt-4">
      <header class="mb-8 border-b border-zinc-800 pb-6 not-prose">
        <h1 class="text-3xl font-semibold text-zinc-100">{title}</h1>
        <p class="mt-2 text-base text-zinc-400">{description}</p>
        <div class="mt-3 flex flex-wrap items-center gap-3 font-mono text-xs text-zinc-500">
          <time datetime={pubDate.toISOString()}>{dateLabel}</time>
          {updatedDate && <span>(updated {updatedDate.toLocaleDateString('en-US')})</span>}
        </div>
        {
          tags.length > 0 && (
            <div class="mt-3 flex flex-wrap gap-1.5">
              {tags.map((tag) => (
                <Tag tag={tag} />
              ))}
            </div>
          )
        }
      </header>

      <div class="prose prose-invert prose-journal max-w-none">
        <slot />
      </div>
    </article>
  </main>
  <Footer />
</BaseLayout>
