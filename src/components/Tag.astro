---
interface Props {
  tag: string;
  class?: string;
}

const { tag, class: className = '' } = Astro.props;
---

<span
  class:list={[
    'inline-flex items-center rounded border border-cyan-400/20 bg-cyan-400/10 px-1.5 py-0.5 font-mono text-[0.7rem] text-cyan-300',
    className
  ]}
>
  {tag}
</span>
