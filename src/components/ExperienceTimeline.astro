---
import { experience } from '../data/experience';
---

<section>
  <h2 class="mb-4 font-mono text-xs uppercase tracking-wider text-zinc-500">Experience</h2>
  <div class="space-y-4">
    {
      experience.map((entry, i) => (
        <article
          class="card-hover rounded-lg border border-zinc-800 bg-zinc-900/40 p-5"
          data-aos="fade-up"
          data-aos-delay={i * 80}
        >
          <div class="flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1">
            <h3 class="text-xl font-medium text-zinc-100">
              {entry.role} · <span class="text-cyan-300">{entry.company}</span>
            </h3>
            <span class="shrink-0 font-mono text-xs text-zinc-500">
              {entry.start} – {entry.end}
            </span>
          </div>
          {entry.context && <p class="mt-0.5 text-sm italic text-zinc-500">{entry.context}</p>}
          <ul class="mt-3 space-y-1.5 text-base text-zinc-400">
            {entry.bullets.map((bullet) => (
              <li class="flex gap-2">
                <span class="mt-2.5 h-1 w-1 shrink-0 rounded-full bg-cyan-400/60" />
                <span>{bullet}</span>
              </li>
            ))}
          </ul>
        </article>
      ))
    }
  </div>
</section>



