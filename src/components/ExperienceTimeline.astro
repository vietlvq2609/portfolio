---
import { experience } from '../data/experience';
---

<section>
  <h2 class="mb-3 font-mono text-xs uppercase tracking-wider text-zinc-500">Experience</h2>
  <ol class="space-y-4 border-l border-zinc-800 pl-4">
    {
      experience.map((entry) => (
        <li>
          <div class="flex flex-wrap items-baseline justify-between gap-x-2">
            <h3 class="text-lg font-medium text-zinc-100">
              {entry.role} · {entry.company}
            </h3>
            <span class="font-mono text-xs text-zinc-500">
              {entry.start} – {entry.end}
            </span>
          </div>
          <p class="text-base text-zinc-400">{entry.highlight}</p>
        </li>
      ))
    }
  </ol>
</section>


