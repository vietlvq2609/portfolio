---
import { Icon } from 'astro-icon/components';
import { social } from '../data/profile';

interface Props {
  size?: 'sm' | 'lg';
}

const { size = 'lg' } = Astro.props;

const links = [
  { href: social.github, icon: 'simple-icons:github', label: 'GitHub' },
  { href: `mailto:${social.email}`, icon: 'lucide:mail', label: 'Email' },
  { href: social.linkedin, icon: 'simple-icons:linkedin', label: 'LinkedIn' }
];

const buttonSize = size === 'lg' ? 'h-10 w-10' : 'h-8 w-8';
const iconSize = size === 'lg' ? 'h-5 w-5' : 'h-4 w-4';
---

<nav class="flex gap-2">
  {
    links.map((link) => (
      <a
        href={link.href}
        aria-label={link.label}
        title={link.label}
        class:list={[
          'inline-flex items-center justify-center rounded-full border border-zinc-800 bg-zinc-900/60 text-zinc-400 transition-colors hover:border-cyan-400/40 hover:text-cyan-400',
          buttonSize
        ]}
      >
        <Icon name={link.icon} class={iconSize} />
      </a>
    ))
  }
</nav>
