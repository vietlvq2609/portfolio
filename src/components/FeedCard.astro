---
import Tag from './Tag.astro';

interface Props {
  type: 'post' | 'project';
  href: string;
  title: string;
  description: string;
  pubDate: Date;
  tags: string[];
}

const { type, href, title, description, pubDate, tags } = Astro.props;

const dateLabel = pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric'
});
---

<a
  href={href}
  class="group block rounded-lg border border-zinc-800 bg-zinc-900/40 p-4 transition-colors hover:border-cyan-400/40"
>
  <div class="mb-2 flex items-center justify-between font-mono text-[0.7rem] text-zinc-500">
    <span class={type === 'project' ? 'text-cyan-400' : 'text-zinc-400'}>
      {type === 'project' ? 'PROJECT' : 'POST'}
    </span>
    <time datetime={pubDate.toISOString()}>{dateLabel}</time>
  </div>
  <h3 class="text-lg font-medium text-zinc-100 group-hover:text-cyan-300">{title}</h3>
  <p class="mt-1 text-base text-zinc-400">{description}</p>
  {
    tags.length > 0 && (
      <div class="mt-3 flex flex-wrap gap-1.5">
        {tags.map((tag) => (
          <Tag tag={tag} />
        ))}
      </div>
    )
  }
</a>
