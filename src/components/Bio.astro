---
import { profile } from "../data/profile";
import ContactLinks from "./ContactLinks.astro";
---

<section class="space-y-5" data-aos="fade-up">
  <div class="flex items-center gap-5">
    <img
      src={profile.avatarUrl}
      alt={profile.name}
      width="88"
      height="88"
      class="h-20 w-20 shrink-0 rounded-full border border-zinc-800 sm:h-56 sm:w-56"
    />
    <div>
      <h1 class="font-mono text-2xl leading-tight text-zinc-100 sm:text-5xl">
        {profile.name}
        <span class="text-zinc-500">({profile.alias})</span>
      </h1>
      <p class="mt-1 text-xl text-cyan-400">{profile.role}</p>
      <p class="font-mono text-sm text-zinc-500">{profile.location}</p>
      <div class="mt-2">
        <ContactLinks size="lg" />
      </div>
    </div>
  </div>
</section>
