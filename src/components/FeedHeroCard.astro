---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Tag from './Tag.astro';

interface Props {
  href: string;
  title: string;
  description: string;
  pubDate: Date;
  tags: string[];
  status?: 'ongoing' | 'completed';
  size: 'lg' | 'md';
  coverImage?: ImageMetadata;
  highlights?: string[];
}

const { href, title, description, pubDate, tags, status, size, coverImage, highlights } =
  Astro.props;

const dateLabel = pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric'
});
---

<a
  href={href}
  class:list={[
    'card-hover group block rounded-lg border border-zinc-800 bg-zinc-900/40 p-5',
    size === 'lg' && coverImage && 'sm:grid sm:grid-cols-2 sm:gap-6 sm:p-0'
  ]}
>
  {
    size === 'lg' && coverImage && (
      <div class="overflow-hidden rounded-t-lg sm:rounded-l-lg sm:rounded-tr-none">
        <Image
          src={coverImage}
          alt=""
          class="h-48 w-full object-cover transition-transform duration-300 group-hover:scale-[1.03] sm:h-full"
        />
      </div>
    )
  }
  <div class:list={[size === 'lg' && coverImage && 'sm:py-5 sm:pr-5']}>
    <div class="mb-2 flex items-center justify-between font-mono text-[0.7rem] text-zinc-500">
      <span class="text-cyan-400">PROJECT</span>
      <time datetime={pubDate.toISOString()}>{dateLabel}</time>
    </div>
    <div class="flex items-center gap-2">
      <h3
        class:list={[
          'font-medium text-zinc-100 group-hover:text-cyan-300',
          size === 'lg' ? 'text-2xl' : 'text-lg'
        ]}
      >
        {title}
      </h3>
      {
        status === 'ongoing' && (
          <span class="inline-flex items-center gap-1 rounded-full border border-emerald-400/30 bg-emerald-400/10 px-2 py-0.5 font-mono text-[0.65rem] text-emerald-300">
            <span class="h-1.5 w-1.5 rounded-full bg-emerald-400" />
            ongoing
          </span>
        )
      }
    </div>
    <p class="mt-1 text-base text-zinc-400">{description}</p>
    {
      highlights && highlights.length > 0 && (
        <ul class="mt-3 space-y-1 text-sm text-zinc-400">
          {highlights.map((point) => (
            <li class="flex gap-2">
              <span class="text-cyan-400" aria-hidden="true">
                ▸
              </span>
              <span>{point}</span>
            </li>
          ))}
        </ul>
      )
    }
    {
      tags.length > 0 && (
        <div class="mt-3 flex flex-wrap gap-1.5">
          {tags.map((tag) => (
            <Tag tag={tag} />
          ))}
        </div>
      )
    }
  </div>
</a>
