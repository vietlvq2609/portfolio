---
interface Props {
  variant?: 'info' | 'warn';
}

const { variant = 'info' } = Astro.props;

const styles = {
  info: 'border-cyan-400/30 bg-cyan-400/5 text-zinc-300',
  warn: 'border-amber-400/30 bg-amber-400/5 text-zinc-300'
};
---

<aside class:list={['not-prose my-4 rounded-lg border px-4 py-3 text-sm', styles[variant]]}>
  <slot />
</aside>
