---
import { education } from "../data/experience";
---

<section>
  <h2 class="mb-4 font-mono text-xs uppercase tracking-wider text-zinc-500">
    Education
  </h2>
  <div
    class="card-hover flex items-center gap-3 rounded-lg border border-zinc-800 bg-zinc-900/40 p-3"
    data-aos="fade-up"
  >
    <span class="text-2xl" aria-hidden="true">🎓</span>
    <div>
      <p class="text-base font-medium text-zinc-100">{education.degree}</p>
      <p class="text-sm text-zinc-400">
        {education.school} · {education.period}
      </p>
    </div>
  </div>
</section>
