---
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import FeedCard from './FeedCard.astro';

type FeedEntry =
  | { type: 'post'; slug: string; data: CollectionEntry<'blog'>['data'] }
  | { type: 'project'; slug: string; data: CollectionEntry<'projects'>['data'] };

const posts = await getCollection('blog', ({ data }) => !data.draft);
const projects = await getCollection('projects', ({ data }) => !data.draft);

const feed: FeedEntry[] = [
  ...posts.map((post) => ({ type: 'post' as const, slug: post.id, data: post.data })),
  ...projects.map((project) => ({ type: 'project' as const, slug: project.id, data: project.data }))
]
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<section>
  <div class="mb-3 flex items-center justify-between">
    <h2 class="font-mono text-xs uppercase tracking-wider text-zinc-500">
      Research &amp; Projects
    </h2>
  </div>
  <div class="grid gap-3 sm:grid-cols-3">
    {
      feed.map((entry, i) => (
        <div data-aos="fade-up" data-aos-delay={i * 80}>
          <FeedCard
            type={entry.type}
            href={entry.type === 'post' ? `/blog/${entry.slug}` : `/projects/${entry.slug}`}
            title={entry.data.title}
            description={entry.data.description}
            pubDate={entry.data.pubDate}
            tags={entry.data.tags}
            status={entry.type === 'project' ? entry.data.status : undefined}
          />
        </div>
      ))
    }
    {
      feed.length === 0 && (
        <p class="text-sm text-zinc-500">Nothing published yet — check back soon.</p>
      )
    }
  </div>
  <div class="mt-4 flex gap-3">
    <a href="/blog" class="btn-pill">view all posts <span aria-hidden="true">&rarr;</span></a>
    <a href="/projects" class="btn-pill">view all projects <span aria-hidden="true">&rarr;</span></a>
  </div>
</section>
