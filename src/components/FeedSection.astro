---
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import FeedCard from './FeedCard.astro';
import FeedHeroCard from './FeedHeroCard.astro';

type FeedEntry =
  | { type: 'post'; slug: string; data: CollectionEntry<'blog'>['data'] }
  | { type: 'project'; slug: string; data: CollectionEntry<'projects'>['data'] };

const posts = await getCollection('blog', ({ data }) => !data.draft);
const projects = await getCollection('projects', ({ data }) => !data.draft);

const flagship = projects.find((project) => project.data.size === 'lg');
const featured = projects
  .filter((project) => project.data.size === 'md')
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const secondary: FeedEntry[] = [
  ...posts.map((post) => ({ type: 'post' as const, slug: post.id, data: post.data })),
  ...projects
    .filter((project) => project.data.size === 'sm')
    .map((project) => ({ type: 'project' as const, slug: project.id, data: project.data }))
]
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 4);
---

<section>
  <div class="mb-3 flex items-center justify-between">
    <h2 class="font-mono text-xs uppercase tracking-wider text-zinc-500">
      Research &amp; Projects
    </h2>
  </div>

  {
    (flagship || featured.length > 0) && (
      <div class="space-y-4" data-aos="fade-up">
        {flagship && (
          <FeedHeroCard
            href={`/projects/${flagship.id}`}
            title={flagship.data.title}
            description={flagship.data.description}
            pubDate={flagship.data.pubDate}
            tags={flagship.data.tags}
            status={flagship.data.status}
            size="lg"
            coverImage={flagship.data.coverImage}
            highlights={flagship.data.highlights}
          />
        )}
        {featured.length > 0 && (
          <div class="grid gap-4 sm:grid-cols-2">
            {featured.map((project) => (
              <FeedHeroCard
                href={`/projects/${project.id}`}
                title={project.data.title}
                description={project.data.description}
                pubDate={project.data.pubDate}
                tags={project.data.tags}
                status={project.data.status}
                size="md"
                coverImage={project.data.coverImage}
                highlights={project.data.highlights}
              />
            ))}
          </div>
        )}
      </div>
    )
  }

  <div class="mt-4 grid gap-3 sm:grid-cols-3">
    {
      secondary.map((entry, i) => (
        <div data-aos="fade-up" data-aos-delay={i * 80}>
          <FeedCard
            type={entry.type}
            href={entry.type === 'post' ? `/blog/${entry.slug}` : `/projects/${entry.slug}`}
            title={entry.data.title}
            description={entry.data.description}
            pubDate={entry.data.pubDate}
            tags={entry.data.tags}
            status={entry.type === 'project' ? entry.data.status : undefined}
          />
        </div>
      ))
    }
    {
      !flagship && featured.length === 0 && secondary.length === 0 && (
        <p class="text-sm text-zinc-500">Nothing published yet — check back soon.</p>
      )
    }
  </div>
  <div class="mt-4 flex gap-3">
    <a href="/blog" class="btn-pill">view all posts <span aria-hidden="true">&rarr;</span></a>
    <a href="/projects" class="btn-pill">view all projects <span aria-hidden="true">&rarr;</span></a>
  </div>
</section>
